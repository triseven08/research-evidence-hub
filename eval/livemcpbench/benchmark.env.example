# Copy to .env.local. Values are literal, not shell commands.
# Run INSIDE the GPU container. The launcher never invokes docker.
CUDA_VISIBLE_DEVICES=0
# Pin the Qwen embedding commit hash, not main/latest.
QWEN_EMBEDDING_REVISION=
EMBEDDING_PORT=18001
EMBEDDING_GPU_MEMORY=0.5
EMBEDDING_MAX_MODEL_LEN=8192
# Configure exact IDs and provider provenance in paper-models.json.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
# Watchdogs stop INCOMPLETE runs, never classify a killed task as model failure.
TASK_TIMEOUT=3600
JUDGE_TIMEOUT=1200
TOOL_CHECK_TIMEOUT=120
STARTUP_TIMEOUT=1800
INDEX_TIMEOUT=7200
CONTAINER_IMAGE_DIGEST=
