# Server-side only. Copy to .env.local; never commit real credentials.
DEEPSEEK_API_KEY=
COOKIE_SECRET=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_THINKING=disabled
DEEPSEEK_MAX_OUTPUT_TOKENS=2000

# Application profile; independent from NODE_ENV. testing is private/local only.
APP_ENV=production
API_USER_DAILY_LIMIT=100
API_TEST_USER_DAILY_LIMIT=1000
API_USER_MINUTE_LIMIT=3
API_TEST_USER_MINUTE_LIMIT=20
API_IP_DAILY_LIMIT=500
API_TEST_IP_DAILY_LIMIT=3000
API_IP_MINUTE_LIMIT=10
API_TEST_IP_MINUTE_LIMIT=60
API_SITE_DAILY_LIMIT=1000
API_TEST_SITE_DAILY_LIMIT=3000
API_SITE_DAILY_BUDGET_USD=5.00
API_USER_CONCURRENCY=1
API_SITE_CONCURRENCY=2
API_QUESTION_MAX_CHARS=2000
API_CONTEXT_MAX_TOKENS=12000
API_TIMEOUT_SECONDS=30
